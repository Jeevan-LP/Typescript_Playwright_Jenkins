{
  "name": "in4suite-playwright",
  "version": "1.0.0",
  "description": "In4Suite Playwright Automation Framework",
  "scripts": {
    "test": "playwright test",
    "test:jenkins": "playwright test tests/jenkinsTest.spec.ts",
    "test:chromium": "playwright test tests/jenkinsTest.spec.ts --project=chromium",
    "test:firefox": "playwright test tests/jenkinsTest.spec.ts --project=firefox",
    "test:webkit": "playwright test tests/jenkinsTest.spec.ts --project=webkit",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.6"
  }
}
